# ═══════════════════════════════════════════════════════════════
# hCaptcha Mega-Trainer — REAL scraped data from 3 sources
# Kaggle: Internet ON, GPU T4 x2 ON → Run All → 3 models out
#
# Sources:
#   🔲 xtekky/hcaptcha-dataset — 6,013 real tiles, 33 classes
#   🐭 Capycap-AI/CaptchaSolve30k — 30k mouse motion patterns
#   🧩 nfsn/SliderCaptcha — 300 slider puzzles w/ YOLO labels
#
# Outputs:
#   model_grid.pth        — tile grid classifier (33 classes)
#   model_drag.pth        — drag position regressor
#   motion_params.json    — learned human mouse behavior
# ═══════════════════════════════════════════════════════════════

import json, os, random, time, math, subprocess, glob
from pathlib import Path

import torch, torch.nn as nn, torchvision, numpy as np
from torchvision import models, transforms
from PIL import Image

OUT = Path("/kaggle/working")
DATA = OUT / "real_data"
for d in ["grid", "slider", "motion"]:
    (DATA / d).mkdir(parents=True, exist_ok=True)

device = torch.device("cuda")
print(f"GPU: {torch.cuda.get_device_name(0)}")
print(f"VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\n")

# ═══════════════════════════════════════════════════════════════
# SOURCE 1: xtekky/hcaptcha-dataset (6,013 real tile grid images)
# ═══════════════════════════════════════════════════════════════

print("=" * 50)
print("SOURCE 1: xtekky/hcaptcha-dataset — 6,013 real tiles")
print("=" * 50)

REPO = DATA / "xtekky_hcaptcha"
if not REPO.exists():
    subprocess.run(["git", "clone", "--depth", "1",
                    "https://github.com/xtekky/hcaptcha-dataset.git",
                    str(REPO)], check=True)

dataset_root = REPO / "dataset"
all_class_dirs = sorted([d for d in dataset_root.iterdir() if d.is_dir()])
print(f"Classes: {len(all_class_dirs)}")

# Count images per class
class_counts = {}
for d in all_class_dirs:
    imgs = list(d.glob("*.[pj][np][g]"))
    class_counts[d.name] = len(imgs)
print(f"Total images: {sum(class_counts.values())}")

# Organize into train/val splits
GRID = DATA / "grid"
for split in ("train", "val"):
    for d in all_class_dirs:
        (GRID / split / d.name).mkdir(parents=True, exist_ok=True)

random.seed(42)
for d in all_class_dirs:
    imgs = sorted(d.glob("*.[pj][np][g]"))
    random.shuffle(imgs)
    n_train = max(1, int(len(imgs) * 0.85))
    for i, img_path in enumerate(imgs):
        split = "train" if i < n_train else "val"
        dest = GRID / split / d.name / f"{d.name}_{i:04d}.jpg"
        # Resize to 224x224
        img = Image.open(img_path).convert("RGB").resize((224, 224), Image.LANCZOS)
        img.save(dest, quality=90)

print(f"Organized tiles into train/val per class")

# ═══════════════════════════════════════════════════════════════
# SOURCE 2: nfsn/SliderCaptcha (300 slider puzzles, YOLO labels)
# ═══════════════════════════════════════════════════════════════

print("\n" + "=" * 50)
print("SOURCE 2: nfsn/SliderCaptcha — 300 slider puzzles")
print("=" * 50)

from huggingface_hub import snapshot_download

SLIDER = DATA / "slider_raw"
try:
    snapshot_download("nfsn/SliderCaptcha", local_dir=str(SLIDER),
                      repo_type="dataset", allow_patterns=["train/images/*", "train/labels/*",
                                                            "valid/images/*", "valid/labels/*",
                                                            "test/images/*", "test/labels/*"])
    print("Downloaded SliderCaptcha dataset")
except Exception as e:
    print(f"SliderCaptcha download failed: {e}")
    SLIDER = None

# Parse YOLO labels and prepare slider training data
slider_train = []
if SLIDER and (SLIDER / "train").exists():
    for split_name in ["train", "valid", "test"]:
        img_dir = SLIDER / split_name / "images"
        lbl_dir = SLIDER / split_name / "labels"
        if not img_dir.exists() or not lbl_dir.exists():
            continue
        for img_path in sorted(img_dir.glob("*.jpg")):
            lbl_path = lbl_dir / f"{img_path.stem}.txt"
            if not lbl_path.exists():
                continue
            with open(lbl_path) as f:
                lines = f.read().strip().split("\n")
            if not lines or not lines[0].strip():
                continue
            parts = lines[0].strip().split()
            if len(parts) >= 3:
                # YOLO: class x_center y_center width height (normalized)
                x, y = float(parts[1]), float(parts[2])
                slider_train.append((str(img_path), x, y))

print(f"Slider samples with valid labels: {len(slider_train)}")

# ═══════════════════════════════════════════════════════════════
# SOURCE 3: Capycap-AI/CaptchaSolve30k (mouse motion patterns)
# ═══════════════════════════════════════════════════════════════

print("\n" + "=" * 50)
print("SOURCE 3: CapycapAI — 30k mouse motion streams")
print("=" * 50)

MOTION = DATA / "motion_raw"
try:
    snapshot_download("Capycap-AI/CaptchaSolve30k", local_dir=str(MOTION),
                      repo_type="dataset", allow_patterns=["train.jsonl"])
    print("Downloaded CaptchaSolve30k dataset")
except Exception as e:
    print(f"CaptchaSolve30k download failed: {e}")
    MOTION = None

# Extract mouse velocity/acceleration statistics from real human streams
motion_stats = {"mean_velocity": 0, "std_velocity": 0, "mean_pause": 0,
                "count": 0, "mean_points": 0, "mean_accel": 0}
if MOTION and (MOTION / "train.jsonl").exists():
    import base64
    velocities, pauses, point_counts, accels = [], [], [], []
    with open(MOTION / "train.jsonl") as f:
        for line_num, line in enumerate(f):
            if line_num > 5000:  # sample 5k rows (enough)
                break
            try:
                row = json.loads(line)
                # The 'raw' field usually contains base64-encoded mouse data
                for key in ["raw", "mousedata", "mouseStream", "stream"]:
                    if key in row:
                        raw_bytes = base64.b64decode(row[key])
                        # Decode as list of [x, y, t] triples
                        pts = []
                        for i in range(0, len(raw_bytes) - 6, 6):
                            x = int.from_bytes(raw_bytes[i:i+2], "little", signed=True)
                            y = int.from_bytes(raw_bytes[i+2:i+4], "little", signed=True)
                            t = int.from_bytes(raw_bytes[i+4:i+6], "little")
                            pts.append((x, y, t))
                        if len(pts) > 3:
                            # Compute velocity between consecutive points
                            for i in range(1, len(pts)):
                                dx = pts[i][0] - pts[i-1][0]
                                dy = pts[i][1] - pts[i-1][1]
                                dt = max(1, pts[i][2] - pts[i-1][2])
                                v = math.sqrt(dx*dx + dy*dy) / dt
                                velocities.append(v)
                                if dt > 30:
                                    pauses.append(dt)
                            point_counts.append(len(pts))
                            for i in range(2, len(pts)):
                                v1 = math.sqrt((pts[i-1][0]-pts[i-2][0])**2 + (pts[i-1][1]-pts[i-2][1])**2) / max(1, pts[i-1][2]-pts[i-2][2])
                                v2 = math.sqrt((pts[i][0]-pts[i-1][0])**2 + (pts[i][1]-pts[i-1][1])**2) / max(1, pts[i][2]-pts[i-1][2])
                                accels.append(abs(v2 - v1) / max(1, pts[i][2]-pts[i-1][2]))
                        break
            except Exception:
                continue

    if velocities:
        motion_stats["mean_velocity"] = np.mean(velocities)
        motion_stats["std_velocity"] = np.std(velocities)
        motion_stats["mean_pause"] = np.mean(pauses) if pauses else 30
        motion_stats["mean_points"] = np.mean(point_counts)
        motion_stats["mean_accel"] = np.mean(accels) if accels else 0.1
        motion_stats["count"] = len(velocities)
        with open(OUT / "motion_params.json", "w") as f:
            json.dump(motion_stats, f, indent=2)
        print(f"Extracted motion stats from {len(point_counts)} real streams")
        print(f"  Mean velocity: {motion_stats['mean_velocity']:.1f} px/ms")
        print(f"  Mean points: {motion_stats['mean_points']:.0f}")
else:
    print("Skipped — no motion data downloaded")

# ═══════════════════════════════════════════════════════════════
# MODEL 1: Tile Grid Classifier (real xtekky data)
# ═══════════════════════════════════════════════════════════════

print("\n" + "=" * 50)
print("MODEL 1: Tile Grid Classifier")
print("=" * 50)

grid_classes = sorted([d.name for d in all_class_dirs])
n_classes = len(grid_classes)
print(f"Classes: {n_classes}")

tf = transforms.Compose([
    transforms.Resize(256),
    transforms.RandomRotation(8),
    transforms.RandomAffine(0, translate=(0.08, 0.08), scale=(0.88, 1.12)),
    transforms.CenterCrop(224),
    transforms.ColorJitter(0.15, 0.15, 0.15),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
])
vtf = transforms.Compose([
    transforms.Resize(256), transforms.CenterCrop(224),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
])

tr_ds = torchvision.datasets.ImageFolder(str(GRID / "train"), tf)
vl_ds = torchvision.datasets.ImageFolder(str(GRID / "val"), vtf)
tr_ld = torch.utils.data.DataLoader(tr_ds, 64, shuffle=True, num_workers=2)
vl_ld = torch.utils.data.DataLoader(vl_ds, 64, shuffle=False, num_workers=2)

# Use ImageNet-pretrained weights — real data + pretrained = very good
model_grid = models.resnet18(weights=models.ResNet18_Weights.IMAGENET1K_V1)
model_grid.fc = nn.Linear(model_grid.fc.in_features, n_classes)
model_grid = model_grid.to(device)

opt = torch.optim.AdamW(model_grid.parameters(), lr=1e-3)
sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=10)
crit = nn.CrossEntropyLoss()

best = 0.0
for ep in range(10):
    model_grid.train(); t0 = time.time(); tot = cor = 0
    for x, y in tr_ld:
        x, y = x.to(device), y.to(device); opt.zero_grad()
        crit(model_grid(x), y).backward(); opt.step()
        tot += y.size(0); cor += (model_grid(x).argmax(1) == y).sum().item()
    sched.step()
    model_grid.eval(); vc = vt = 0
    with torch.no_grad():
        for x, y in vl_ld:
            x, y = x.to(device), y.to(device)
            vc += (model_grid(x).argmax(1) == y).sum().item()
            vt += y.size(0)
    acc = vc / vt; best = max(best, acc)
    print(f"  ep {ep+1:2d}  train {100*cor/tot:5.1f}%  val {100*acc:5.1f}%  {time.time()-t0:.0f}s")

torch.save({"state_dict": model_grid.state_dict(), "classes": grid_classes},
           OUT / "model_grid.pth")
print(f"Best val: {100*best:.1f}%")
print(f"Saved: {OUT / 'model_grid.pth'}")

# ═══════════════════════════════════════════════════════════════
# MODEL 2: Drag Position Regressor (slider puzzle data)
# ═══════════════════════════════════════════════════════════════

print("\n" + "=" * 50)
print("MODEL 2: Drag Position Regressor")
print("=" * 50)

if len(slider_train) > 20:
    # Simple regression: image → (x, y) normalized coordinates
    class SliderDataset(torch.utils.data.Dataset):
        def __init__(self, items):
            self.items = items
            self.tf = transforms.Compose([
                transforms.Resize((224, 224)),
                transforms.ToTensor(),
                transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
            ])

        def __len__(self):
            return len(self.items)

        def __getitem__(self, idx):
            path, x, y = self.items[idx]
            img = Image.open(path).convert("RGB")
            return self.tf(img), torch.tensor([x, y], dtype=torch.float32)

    random.shuffle(slider_train)
    split = int(len(slider_train) * 0.85)
    tr_slider = SliderDataset(slider_train[:split])
    vl_slider = SliderDataset(slider_train[split:])
    tr_sl = torch.utils.data.DataLoader(tr_slider, 32, shuffle=True)
    vl_sl = torch.utils.data.DataLoader(vl_slider, 32)

    model_drag = models.resnet18(weights=models.ResNet18_Weights.IMAGENET1K_V1)
    model_drag.fc = nn.Linear(model_drag.fc.in_features, 2)  # regress x, y
    model_drag = model_drag.to(device)

    opt_d = torch.optim.AdamW(model_drag.parameters(), lr=1e-3)
    sched_d = torch.optim.lr_scheduler.CosineAnnealingLR(opt_d, T_max=15)
    loss_fn = nn.MSELoss()

    best_loss = float("inf")
    for ep in range(15):
        model_drag.train(); t0 = time.time(); tr_loss = 0.0
        for x, y in tr_sl:
            x, y = x.to(device), y.to(device); opt_d.zero_grad()
            loss = loss_fn(model_drag(x), y); loss.backward(); opt_d.step()
            tr_loss += loss.item() * x.size(0)
        sched_d.step()
        model_drag.eval(); vl_loss = 0.0
        with torch.no_grad():
            for x, y in vl_sl:
                x, y = x.to(device), y.to(device)
                vl_loss += loss_fn(model_drag(x), y).item() * x.size(0)
        print(f"  ep {ep+1:2d}  train loss {tr_loss/len(tr_slider):.4f}  "
              f"val loss {vl_loss/len(vl_slider):.4f}  {time.time()-t0:.0f}s")
        if vl_loss < best_loss:
            best_loss = vl_loss

    torch.save({"state_dict": model_drag.state_dict()}, OUT / "model_drag.pth")
    print(f"Best val MSE: {best_loss/len(vl_slider):.4f}")
    print(f"Saved: {OUT / 'model_drag.pth'}")
else:
    print(f"Not enough slider samples ({len(slider_train)}). Skipping drag model.")

# ═══════════════════════════════════════════════════════════════
# Summary
# ═══════════════════════════════════════════════════════════════
print("\n" + "=" * 50)
print("OUTPUT FILES — download all three:")
print(f"  1. {OUT / 'model_grid.pth'}  — tile grid classifier ({n_classes} classes)")
if len(slider_train) > 20:
    print(f"  2. {OUT / 'model_drag.pth'}  — drag position regressor")
else:
    print(f"  2. (skipped — not enough slider data)")
print(f"  3. {OUT / 'motion_params.json'}  — human mouse behavior stats")
